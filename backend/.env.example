# Porta HTTP da API
PORT=3000
# Segredo usado para assinar os tokens JWT (troque em produção!)
JWT_SECRET=troque-este-segredo
# Validade do token
JWT_EXPIRES_IN=8h
# Arquivo do banco SQLite (use :memory: para banco temporário)
DB_FILE=./data/blog.db
# Popular o banco com dados de exemplo quando ele estiver vazio
SEED_ON_START=true
